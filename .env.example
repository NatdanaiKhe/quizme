# Postgres
DATABASE_URL=postgres://quizme:quizme@localhost:5432/quizme?sslmode=disable

# AI API (used by generation service)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-...

# Internal auth token for /internal/generate
INTERNAL_TOKEN=change-me

# Webhook URL for batch completion notifications.
# This feeds an n8n/LINE relay; the backend sender is provider-agnostic.
WEBHOOK_URL=https://example.com/webhook

# Server port
PORT=8080

# CORS origin for local frontend dev (TASK-8). Use '*' to allow any origin.
CORS_ORIGIN=http://localhost:5173

# --- Homelab Deployment (Traefik + GHCR) ---
DOMAIN=quizme.example.com
TRAEFIK_CERTRESOLVER=letsencrypt
GHCR_IMAGE=ghcr.io/natdanaikhe/quizme:latest
GHCR_MIGRATOR_IMAGE=ghcr.io/natdanaikhe/quizme-migrator:latest
